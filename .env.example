# NPFTV demo: environment variables
# Copy this file to .env.local (git ignores it) and fill in your own key there.
# Never put a real key in this file: it is committed to git.
# On Vercel: Project Settings > Environment Variables, add the same names, then redeploy.

# OpenAI API key, used only by the server route app/api/ai/route.ts.
# Leave it empty and the whole demo still works on scripted AI answers.
OPENAI_API_KEY=

# Model for every AI feature (default: gpt-5-mini).
OPENAI_MODEL=gpt-5-mini

# Most AI requests the server will make per day before falling back to scripted answers (default: 2000).
AI_DAILY_REQUEST_LIMIT=2000
